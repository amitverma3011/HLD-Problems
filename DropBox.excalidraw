    {
      "id": "nf3w0ikfvSx1WxmCmvEYg",
      "type": "text",
      "x": -336.40942340484804,
      "y": 2190.187505883848,
      "width": 633.1795654296875,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ay",
      "roundness": null,
      "seed": 1244501575,
      "version": 656,
      "versionNonce": 1117466281,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1780826730962,
      "link": null,
      "locked": false,
      "text": "- As we can see here, we are technically uploading the files\n  twice, once to our file service and then to blob storage\n- This is redundant, we can actually remove this redundancy\n   by uploading the file directly to the blob from the client\n- As we are uplading directly to the blob storage\n  then the post API will change and it will be three step process\n  - POST /files -----> preSignedUrl\n    body: fileMetadata\n  - PUT {Presigned Url}\n    body: File\n  - PATCH /files/ ---> 200\n    body: paritalFileMetadata\n           with upload status:done",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- As we can see here, we are technically uploading the files\n  twice, once to our file service and then to blob storage\n- This is redundant, we can actually remove this redundancy\n   by uploading the file directly to the blob from the client\n- As we are uplading directly to the blob storage\n  then the post API will change and it will be three step process\n  - POST /files -----> preSignedUrl\n    body: fileMetadata\n  - PUT {Presigned Url}\n    body: File\n  - PATCH /files/ ---> 200\n    body: paritalFileMetadata\n           with upload status:done",
      "autoResize": true,
      "lineHeight": 1.25
    },
