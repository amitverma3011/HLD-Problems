      "boundElements": null,
      "updated": 1780812367464,
      "link": null,
      "locked": false,
      "text": "4. API Endpoints:-\n\n- To upload files\n POST /files\nRequest:\n{\n    file,\n    fileMetadata\n}\n\n- Download the files\nGET /files/:fileId ----> file\n\n- // Sync to local devices\nGET /files/changes?since = {timeStamp} ->\nfileIDs[]",
      "fontSize": 11.87529504675379,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. API Endpoints:-\n\n- To upload files\n POST /files\nRequest:\n{\n    file,\n    fileMetadata\n}\n\n- Download the files\nGET /files/:fileId ----> file\n\n- // Sync to local devices\nGET /files/changes?since = {timeStamp} -> fileIDs[]",
      "autoResize": false,
      "lineHeight": 1.25
    },
