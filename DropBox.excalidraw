      "updated": 1780812367464,
      "link": null,
      "locked": false,
      "text": "1. Functional requirements\n\n- User can upload their files\n- User can download the files \n- User can share the files\n- User can sync on other devices\n",
      "fontSize": 16.077620305289646,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Functional requirements\n\n- User can upload their files\n- User can download the files \n- User can share the files\n- User can sync on other devices\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
