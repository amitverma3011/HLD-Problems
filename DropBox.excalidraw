    {
      "id": "YWBmqeWW8yu4LYuMYrEAy",
      "type": "text",
      "x": 225.6360105408704,
      "y": 300.70463117843434,
      "width": 280.74636640103694,
      "height": 182.04566459286278,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
